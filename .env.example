# ============================================================
#  ConvertIA :: variables de entorno
#  Copia este archivo a `.env` antes de `docker-compose up --build`
#     cp .env.example .env
# ============================================================

# ---------- PostgreSQL (servicio `db` de docker-compose) ----------
POSTGRES_USER=convertia
POSTGRES_PASSWORD=convertia
POSTGRES_DB=convertia
DB_PORT=5432

# ---------- Puerto publico de la app ----------
APP_PORT=3000

# ---------- Conexion de Prisma ----------
# DENTRO de Docker el host es el nombre del servicio: `db`
DATABASE_URL="postgresql://convertia:convertia@db:5432/convertia?schema=public&connection_limit=10"
#
# FUERA de Docker (npm run dev en tu maquina, con el contenedor `db` levantado)
# usa localhost en lugar de db:
# DATABASE_URL="postgresql://convertia:convertia@localhost:5432/convertia?schema=public"
#
# Base de datos EN LA NUBE (Neon / Supabase / Railway): pega aqui tu cadena
# y comenta el servicio `db` en docker-compose.yml.
# DATABASE_URL="postgresql://usuario:pass@host.neon.tech/convertia?sslmode=require"

# ---------- Branding / UI ----------
NEXT_PUBLIC_APP_NAME=ConvertIA
# Destino del boton "Ejecutar en Claude" (sesion activa en el navegador)
NEXT_PUBLIC_CLAUDE_WEB_URL=https://claude.ai/new

# ---------- (OPCIONAL) Generacion integrada con Claude ----------
# ConvertIA funciona sin esto: compila el Prompt Maestro y tu lo pegas en la IA
# que quieras. Si ademas quieres el boton "Generar landing" DENTRO de la app,
# pon aqui tu clave de https://console.anthropic.com/settings/keys
# Ojo: cada generacion consume creditos de tu cuenta.
# Si dejas la variable vacia, el boton simplemente no aparece.
ANTHROPIC_API_KEY=
# Modelo usado por ese boton (opcional).
ANTHROPIC_MODEL=claude-opus-5

# ---------- (OPCIONAL) Generacion de video con Gemini / Veo ----------
# Solo hace falta si quieres que ConvertIA genere el clip del hero.
# Consigue las claves en https://aistudio.google.com/apikey
# OJO: Veo se factura POR SEGUNDO de video. Un clip corto cuesta dolares,
# no centimos. Las imagenes son mucho mas baratas que el video.
# Puedes poner dos claves: si la primera agota su cuota, se usa la segunda.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# Modelo de video. Si tu clave no lo acepta, consulta los disponibles en
# http://localhost:3300/api/assets/video?modelos=1
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# ---------- (OPCIONAL) Fotos tematicas con Unsplash ----------
# Sin clave, las landings usan fotos de relleno que cargan pero son aleatorias.
# Con clave, ConvertIA busca fotos que SI tienen que ver con el tema y deja la
# URL definitiva en el HTML (el archivo sigue siendo autosuficiente).
# Consiguela gratis y sin tarjeta en https://unsplash.com/oauth/applications
# (crea una aplicacion y copia el "Access Key").
UNSPLASH_ACCESS_KEY=
